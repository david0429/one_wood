# ---------------------------------------------------------------------------
# Line endings
# Normalize text to LF in the repo. Unity writes LF on every platform.
# ---------------------------------------------------------------------------
* text=auto

*.cs              text diff=csharp
*.shader          text
*.hlsl            text
*.cginc           text
*.compute         text
*.json            text
*.md              text
*.txt             text
*.xml             text
*.yml             text
*.yaml            text
*.sh              text eol=lf
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# ---------------------------------------------------------------------------
# Unity YAML (Force Text serialization)
# merge=unityyamlmerge uses Unity's Smart Merge if it is configured locally
# (see README "Development setup"); otherwise git uses its normal text merge.
# linguist-generated hides these from GitHub diff stats.
# ---------------------------------------------------------------------------
*.unity           text eol=lf merge=unityyamlmerge linguist-generated
*.prefab          text eol=lf merge=unityyamlmerge linguist-generated
*.asset           text eol=lf merge=unityyamlmerge linguist-generated
*.meta            text eol=lf merge=unityyamlmerge linguist-generated
*.mat             text eol=lf merge=unityyamlmerge linguist-generated
*.anim            text eol=lf merge=unityyamlmerge linguist-generated
*.controller      text eol=lf merge=unityyamlmerge linguist-generated
*.overrideController text eol=lf merge=unityyamlmerge linguist-generated
*.mask            text eol=lf merge=unityyamlmerge linguist-generated
*.physicMaterial  text eol=lf merge=unityyamlmerge linguist-generated
*.physicsMaterial2D text eol=lf merge=unityyamlmerge linguist-generated
*.playable        text eol=lf merge=unityyamlmerge linguist-generated
*.signal          text eol=lf merge=unityyamlmerge linguist-generated
*.mixer           text eol=lf merge=unityyamlmerge linguist-generated
*.flare           text eol=lf merge=unityyamlmerge linguist-generated
*.guiskin         text eol=lf merge=unityyamlmerge linguist-generated
*.fontsettings    text eol=lf merge=unityyamlmerge linguist-generated
*.brush           text eol=lf merge=unityyamlmerge linguist-generated
*.terrainlayer    text eol=lf merge=unityyamlmerge linguist-generated
*.lighting        text eol=lf merge=unityyamlmerge linguist-generated
*.spriteatlas     text eol=lf merge=unityyamlmerge linguist-generated
*.spriteatlasv2   text eol=lf merge=unityyamlmerge linguist-generated
*.inputactions    text eol=lf
*.shadergraph     text eol=lf linguist-generated
*.shadersubgraph  text eol=lf linguist-generated
*.vfx             text eol=lf linguist-generated
*.vfxoperator     text eol=lf linguist-generated
*.vfxblock        text eol=lf linguist-generated
*.uxml            text eol=lf
*.uss             text eol=lf
*.asmdef          text eol=lf
*.asmref          text eol=lf

# ---------------------------------------------------------------------------
# Git LFS
# These come after the text rules, so for a matching file the LFS filter
# (and -text) wins.
# ---------------------------------------------------------------------------

# Unity assets that are binary even with Force Text, or very large
LightingData.asset            filter=lfs diff=lfs merge=lfs -text
*[Ll]ighting[Dd]ata.asset     filter=lfs diff=lfs merge=lfs -text
NavMesh.asset                 filter=lfs diff=lfs merge=lfs -text
NavMesh-*.asset               filter=lfs diff=lfs merge=lfs -text
# Convention: keep TerrainData assets in a folder named TerrainData/
**/TerrainData/*.asset        filter=lfs diff=lfs merge=lfs -text
*.cubemap                     filter=lfs diff=lfs merge=lfs -text
*.unitypackage                filter=lfs diff=lfs merge=lfs -text

