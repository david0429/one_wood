# ---------------------------------------------------------------------------
# Unity (project lives in OneWood/)
# Patterns without a leading "/" match at any depth, so they cover OneWood/.
# ---------------------------------------------------------------------------

# Regenerated by the editor
/OneWood/[Ll]ibrary/
/OneWood/[Tt]emp/
/OneWood/[Oo]bj/
/OneWood/[Ll]ogs/
/OneWood/[Uu]ser[Ss]ettings/
/OneWood/[Mm]emoryCaptures/
/OneWood/[Rr]ecordings/

# Build output
/OneWood/[Bb]uild/
/OneWood/[Bb]uilds/
/OneWood/[Bb]uild[Ll]ogs/

# Asset Store tools plugin
/OneWood/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/OneWood/[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle / Android cache (in case a mobile target is ever added)
.gradle/

# IDE solution/project files (Unity regenerates these)
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored content
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Burst / IL2CPP debug info
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Packed addressables
/OneWood/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/OneWood/[Aa]ssets/[Ss]treamingAssets/aa.meta
/OneWood/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# One Wood project-specific
# ---------------------------------------------------------------------------

# Recorded shot logs from live sessions (curated samples go in Tools/ShotLogs/)
/OneWood/[Ll]ogs/shots/

# .NET tool build output
/Tools/**/bin/
/Tools/**/obj/

# Blender autosaves/backups
*.blend1
*.blend2

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
